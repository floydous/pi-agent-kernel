{
  "name": "@floydous/pi-agent-kernel",
  "version": "0.5.0",
  "description": "Focused code retrieval, editing, and safety checks for Pi.",
  "keywords": [
    "pi-package"
  ],
  "license": "ISC",
  "author": "floydous https://github.com/floydous",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "npx tsx tests/run-all.ts",
    "typecheck": "tsc --noEmit",
    "preindex": "npx tsx agent-kernel-benchmark/preindex.ts",
    "bench": "npx tsx agent-kernel-benchmark/run.ts",
    "bench:clean": "npx tsx agent-kernel-benchmark/run.ts --clean",
    "bench:chart": "PATH=\"$HOME/.local/bin:$HOME/.venv/bin:$PATH\" python3 agent-kernel-benchmark/generate_chart.py"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "cross-spawn": "^7.0.6",
    "diff": "^9.0.0",
    "ignore": "^7.0.5",
    "typebox": "^1.3.16",
    "typescript": "^7.0.2",
    "web-tree-sitter": "^0.26.12"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "tsx": "^4.23.13"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "sharp": "^0.35.4"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floydous/pi-agent-kernel.git"
  },
  "files": [
    "src",
    "grammars",
    "README.md",
    "docs",
    "LICENSE",
    "config.example.toml",
    "AGENT_KERNEL_SYS_PROMPT.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
